{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome-types"],
    "strict": true
  },
  "include": ["sw.js", "core/**/*.js", "features/**/*.js", "ui/**/*.js", "tools/**/*.js", "e2e/**/*.js"],
  "exclude": ["node_modules"]
}
